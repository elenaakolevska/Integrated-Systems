@{
    ViewData["Title"] = "Home Page";
}


@model List<TransferRequest>

<div class="container">

    @*  <div class="row">
    <a class="btn btn-outline-danger" asp-controller="Order" asp-action="ExportAllOrders">Export Orders</a>
    </div> *@


    <table class="table mt-5">
        <thead class="thead-dark">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Costumer Details</th>
                <th scope="col">Number of products</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];

                <tr>
                    <th scope="row">@(i + 1)</th>
                    <td>
                        @if (item.CreatedBy != null)
                        {
                            @($"{item.CreatedBy.Name} {item.CreatedBy.Surname} - {item.CreatedBy.Email}")
                        }
                        else
                        {
                            <span class="text-muted">No creator info</span>
                        }
                    </td>
                    <td>@item.CourseTransfers.Count()</td>
                    <td><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a></td>
                    <td><a class="btn btn-outline-primary" asp-action="CreateInvoice" asp-route-id="@item.Id">Create Invoice</a></td>
                </tr>

            }
        </tbody>


    </table>

</div>